# Copy to .env and fill in your own values. Never commit a filled-in .env.
# Patkan never ships a shared key — a self-hosted copy runs entirely on your accounts.

# --- Your own Supabase project (server side) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- The same project, browser side ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- AI engine: set at least one of these, or transforms return "AI is not configured" ---
NOUS_API_KEY=""
LOVABLE_API_KEY=""
# PATKAN_ENGINE_MODEL="qwen/qwen3.7-flash"
# PATKAN_ENGINE_SECONDARY_MODEL="z-ai/glm-4.7-flash"

# --- Access control for your own deployment ---
# Comma-separated origins allowed to call /api/public/*. Defaults to Patkan's own origins.
# PATKAN_ALLOWED_ORIGINS="https://your-host.example,https://www.your-host.example"
# Daily transform ceiling per IP address (default 50).
# PATKAN_IP_DAILY_CEILING="50"
